<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use App\Models\ProductModel;
use App\Models\KategoriModel;
use App\Models\Ingredient;
use App\Models\ForbiddenIngredient;

class AIEnhancedProductSeeder extends Seeder
{
    public function run()
    {
        // Create comprehensive categories (12 categories as requested)
        $categories = [
            ['nama_kategori' => 'Makanan Kaleng & Kemasan', 'description' => 'Makanan dalam kemasan kaleng, botol, dan vakum'],
            ['nama_kategori' => 'Minuman Ringan', 'description' => 'Minuman soda, jus buah, dan minuman bersoda'],
            ['nama_kategori' => 'Makanan Ringan', 'description' => 'Snack, keripik, biskuit, dan makanan ringan'],
            ['nama_kategori' => 'Bumbu & Saus', 'description' => 'Bumbu dapur, saus, kecap, dan penyedap rasa'],
            ['nama_kategori' => 'Produk Susu', 'description' => 'Susu, yogurt, keju, dan produk olahan susu'],
            ['nama_kategori' => 'Kosmetik & Perawatan', 'description' => 'Kosmetik, skincare, dan perawatan tubuh'],
            ['nama_kategori' => 'Obat Bebas', 'description' => 'Obat-obatan bebas, vitamin, dan suplemen kesehatan'],
            ['nama_kategori' => 'Makanan Bayi', 'description' => 'Makanan dan minuman khusus untuk bayi'],
            ['nama_kategori' => 'Makanan Beku', 'description' => 'Makanan beku, es krim, dan olahan dingin'],
            ['nama_kategori' => 'Minuman Berenergi', 'description' => 'Minuman energi, sport drink, dan minuman isotonik'],
            ['nama_kategori' => 'Cokelat & Permen', 'description' => 'Cokelat, permen, dan makanan manis lainnya'],
            ['nama_kategori' => 'Makanan Instan', 'description' => 'Mie instan, makanan cepat saji, dan instant food'],
        ];

        $categoryIds = [];
        foreach ($categories as $category) {
            $cat = KategoriModel::firstOrCreate(
                ['nama_kategori' => $category['nama_kategori']],
                ['description' => $category['description']]
            );
            $categoryIds[$category['nama_kategori']] = $cat->id_kategori;
        }

        // AI-generated comprehensive product data
        $products = $this->generateAIProducts($categoryIds);

        foreach ($products as $productData) {
            ProductModel::create($productData);
        }

        // Create ingredients encyclopedia with images
        $this->createIngredientsEncyclopedia();

        // Create forbidden ingredients with images
        $this->createForbiddenIngredientsWithImages();
    }

