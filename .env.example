# ─────────────────────────────────────────────
# Halalytics - Environment Configuration
# Copy this file to .env and fill in credentials
# ─────────────────────────────────────────────

# ── App Config ──
APP_NAME=Halalytics
APP_ENV=local
APP_KEY=
APP_DEBUG=false                     # Set to false in production
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # Set to 'warning' in production

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://halalytics.com,https://admin.halalytics.com

# ── Database (MySQL) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=halalytics
DB_USERNAME=root
DB_PASSWORD=

# ── Broadcast / Queue / Cache / Session ──
BROADCAST_DRIVER=reverb             # Uses Laravel Reverb for WebSockets
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync               # Use 'database' or 'redis' in production
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (SMTP Gmail) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=                       # Gmail App Password (16 chars, no spaces)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Halalytics"

# ── AWS (S3 / SES) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Pusher (legacy / fallback) ──
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Gemini AI (Required) ──
GEMINI_API_KEY=                      # Get from https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.3

# ── Laravel Reverb (WebSockets) ──
REVERB_APP_ID=                       # Run: php artisan reverb:generate
REVERB_APP_KEY=                      # Run: php artisan reverb:generate
REVERB_APP_SECRET=                   # Run: php artisan reverb:generate
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Vite env vars (must match REVERB_ values)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Unsplash (for banner / article images) ──
UNSPLASH_ACCESS_KEY=                 # Get from https://unsplash.com/developers

# ── Google APIs ──
GOOGLE_CLIENT_ID=                    # OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=                # OAuth 2.0 Client Secret
GOOGLE_REDIRECT_URI=                 # OAuth redirect URI
GOOGLE_PLACES_API_KEY=               # Google Places API key
GOOGLE_CUSTOM_SEARCH_API_KEY=        # Custom Search API key
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=      # Custom Search Engine ID

# ── Facebook OAuth ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# ── Midtrans (Payment Gateway) ──
MIDTRANS_SERVER_KEY=                 # Midtrans Server Key (from dashboard)
MIDTRANS_CLIENT_KEY=                 # Midtrans Client Key (from dashboard)
MIDTRANS_MERCHANT_ID=                # Midtrans Merchant ID
MIDTRANS_IS_PRODUCTION=false

# ── MUI Halal API ──
MUI_API_URL=https://api.halalmui.org
MUI_API_KEY=

# ── JAKIM Halal API (Malaysia) ──
JAKIM_API_URL=
JAKIM_API_KEY=

# ── Firebase Cloud Messaging ──
FIREBASE_CREDENTIALS=                # Path or JSON content for FCM service account

# ── Mailgun (alternative mail driver) ──
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# ── Postmark (alternative mail driver) ──
POSTMARK_TOKEN=
